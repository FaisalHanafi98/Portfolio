#!/bin/bash
# Portfolio pre-commit gate (V3.2 / Phase 1 pilot).
# Order matters. First failure blocks the commit.
#   1. Session guard  (B3)
#   2. L1 structural  (compile + typecheck)
#   3. L2 FULL runtime (real user path) — THE gate
#   4. Update state.json (B4)
#
# Emergency bypass (discouraged, logged):
#   SOP_EMERGENCY_BYPASS=1 SOP_BYPASS_REASON='reason' git commit ...

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
ORCH_DIR="$REPO_ROOT/../.orchestrator"
BYPASS_LOG="$ORCH_DIR/.commit_bypasses.log"

if [ "${SOP_EMERGENCY_BYPASS:-0}" = "1" ]; then
  reason="${SOP_BYPASS_REASON:-no-reason-given}"
  mkdir -p "$ORCH_DIR"
  echo "$(date -Iseconds)  Portfolio  reason=$reason" >> "$BYPASS_LOG"
  echo "pre-commit: EMERGENCY BYPASS ($reason) — logged to $BYPASS_LOG"
  exit 0
fi

echo "=============================================="
echo "  Portfolio pre-commit gate"
echo "=============================================="

# 1. Session guard.
if [ -x "$ORCH_DIR/session_guard.sh" ]; then
  "$ORCH_DIR/session_guard.sh" check
else
  echo "pre-commit: WARN — .orchestrator/session_guard.sh missing, skipping cap check"
fi

# 2. L1 structural.
"$REPO_ROOT/scripts/healthcheck.sh" --l1

# 3. L2 FULL — the runtime truth gate.
"$REPO_ROOT/scripts/healthcheck.sh" --l2-full

# 4. Update state.json with GREEN status and the commit SHA we are about to create.
# Note: we use HEAD's parent logic — at pre-commit time, HEAD is the parent of the pending commit.
# We write the state against GREEN now; post-commit could overwrite with the new SHA if desired.
if [ -f "$ORCH_DIR/update_state.py" ]; then
  CURRENT_HEAD=$(git rev-parse HEAD 2>/dev/null || echo "")
  python "$ORCH_DIR/update_state.py" Portfolio GREEN "$CURRENT_HEAD" || {
    echo "pre-commit: WARN — state.json update failed (not blocking)"
  }
fi

echo "=============================================="
echo "  Commit allowed."
echo "=============================================="
